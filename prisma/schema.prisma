datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  password      String?
  image         String?
  bio           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  showcases     ShowcasePost[]
  comments      Comment[]
  threads       ForumThread[]
  answers       ForumAnswer[]
  threadVotes   ThreadVote[]
  answerVotes   AnswerVote[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ShowcasePost {
  id           String      @id @default(cuid())
  title        String
  imageUrl     String
  sizeSpan     String      @default("normal") // normal, tall, wide
  dimensions   String      // Contoh: "30x20x20 cm"
  lighting     String?
  co2System    String?
  plants       String[]
  fauna        String[]
  likesCount   Int         @default(0)
  createdAt    DateTime    @default(now())

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     Comment[]
}

model Comment {
  id           String       @id @default(cuid())
  content      String
  createdAt    DateTime     @default(now())

  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  showcaseId   String
  showcase     ShowcasePost @relation(fields: [showcaseId], references: [id], onDelete: Cascade)
}

model ForumThread {
  id           String        @id @default(cuid())
  title        String
  content      String
  tag          String        // Alga, ParameterAir, Peralatan, dll.
  upvotesCount Int           @default(0)
  isSolved     Boolean       @default(false)
  createdAt    DateTime      @default(now())

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      ForumAnswer[]
  votes        ThreadVote[]
}

model ForumAnswer {
  id           String       @id @default(cuid())
  content      String
  isAccepted   Boolean      @default(false)
  upvotesCount Int          @default(0)
  createdAt    DateTime     @default(now())

  threadId     String
  thread       ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes        AnswerVote[]
}

model ThreadVote {
  id        String      @id @default(cuid())
  type      Int         // 1 untuk Upvote, -1 untuk Downvote
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
}

model AnswerVote {
  id        String      @id @default(cuid())
  type      Int         // 1 untuk Upvote, -1 untuk Downvote
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerId  String
  answer    ForumAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, answerId])
}
